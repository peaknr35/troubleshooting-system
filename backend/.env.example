# Backend configuration (all optional; sensible defaults exist).
# NOTE: there are NO provider API keys here. Keys arrive per request from the
# client and are never stored on the server.

APP_LOG_LEVEL=INFO
# Comma-separated allowed CORS origins. Use your frontend URL in production.
APP_CORS_ORIGINS=*
# Request timeout (seconds) for provider calls.
APP_REQUEST_TIMEOUT=120

# Default models per provider (overridable per request from the client).
APP_OPENAI_DEFAULT_MODEL=gpt-5.1
APP_ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5
APP_KIMI_DEFAULT_MODEL=kimi-k2-0905-preview

# Research defaults
APP_DEFAULT_MAX_SUBQUESTIONS=4
APP_SEARCH_MAX_RESULTS=5
