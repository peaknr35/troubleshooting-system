# URL of the FastAPI backend. In docker-compose this is set for you.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Optional: enables the "Create Google Doc" export (OAuth). Leave blank to use
# the copy-to-clipboard export only. Create an OAuth Client ID (Web) in Google
# Cloud with the Docs + Drive APIs enabled, and add your origin to authorized
# JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
